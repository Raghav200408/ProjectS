TARGET_HOST=https://projects-v8fc.onrender.com
# Informational only; never used for API requests.
FRONTEND_URL=https://hintmatrix-project.onrender.com
# Single account is suitable for smoke only. Never commit real values.
TEST_EMAIL=
TEST_PASSWORD=
# For load runs, CSV header: email,password (one dedicated student per user).
ACCOUNTS_CSV=
ALLOW_SHARED_ACCOUNT=false
REQUEST_TIMEOUT=30
THINK_MIN=2
THINK_MAX=5
# Strict coverage: empty catalogue/question/exam lists fail validation.
# Set false only when empty assigned exams/content are intentional; this reduces coverage.
REQUIRE_DATA=true
